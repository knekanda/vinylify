# Copy this file to .env.local and fill in your Spotify Developer app values.
# See https://developer.spotify.com/dashboard — create an app and set the
# redirect URI to exactly match NEXT_PUBLIC_SPOTIFY_REDIRECT_URI below.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback